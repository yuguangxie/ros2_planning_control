# Keep text files stable across Windows checkout and Ubuntu runtime.
# AD Package checksums are byte-for-byte SHA-256, so checksum-sensitive
# sample data must not be rewritten from LF to CRLF by Git.
* text=auto

*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.py text eol=lf
*.launch.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.srv text eol=lf
*.msg text eol=lf
*.csv text eol=lf
*.sha256 text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.ps1 text eol=lf
.gitattributes text eol=lf

# Binary or potentially binary runtime artifacts.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.bag binary
*.db3 binary
*.mcap binary
